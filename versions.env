# Pinned, mutually-validated versions for the Aerial + OAI + dApp stack.
#
# These are NVIDIA's own pairings for Aerial Testbed 1.0 / cuBB 26-1 on a
# GB10 (DGX Spark) class host. Do not mix releases across rows: the nvIPC/FAPI
# contract between Aerial L1 and the OAI L2 changes between releases, and a
# mismatch fails at nFAPI handshake rather than at build time.
#
# Override anything here in site/versions.env (untracked), e.g. a different
# RU profile or a newer Aerial tag.

# ---- Aerial L1 (NGC; requires `docker login nvcr.io`) ----
AERIAL_IMAGE="nvcr.io/nvidia/aerial/aerial-cuda-accelerated-ran"
AERIAL_TAG="26-1-cubb"                 # Aerial CUDA-Accelerated RAN 26.1.0
AERIAL_SRC_URL="https://github.com/NVIDIA/aerial-cuda-accelerated-ran.git"
AERIAL_SRC_REF="26.1.1"

# ---- OAI L2/L3 (the branch carrying the matching nFAPI/AERIAL glue) ----
OAI_URL="https://gitlab.eurecom.fr/oai/openairinterface5g.git"
OAI_REF="ATB1.0_integration"           # pairs with Aerial Testbed 1.0 / cuBB 26-1

# ---- dApp framework (E3 interface, PRB Power reference app) ----
SAMPLE_APPS_URL="https://github.com/NVIDIA/aerial-sample-apps.git"
SAMPLE_APPS_REF="main"                 # Aerial Sample Apps 1.0

# ---- OAI 5G core (Helm charts) ----
OAI_CHARTS_URL="https://github.com/openairinterface/orchestration.git"
OAI_CHARTS_REF="main"

# ---- Host requirements (checked read-only by 20-preflight.sh) ----
# From NVIDIA's "Installing Tools on DGX Spark" guide. Preflight reports
# mismatches; it never changes the host.
REQ_ARCH="aarch64"
REQ_KERNEL="6.17.0-1014-nvidia"
REQ_DRIVER="590.48.01"
REQ_CUDA="13.1"
REQ_OFED="25.10-1.7.1"
REQ_DOCA="3.2.1"
REQ_HUGEPAGES_1G="24"
REQ_ISOLCPUS="4-19"
REQ_FH_MTU="8192"
REQ_PTP_DOMAIN="24"
# Disk needed just for the Aerial container image (~26 GB) plus build room.
REQ_FREE_GB="80"
