# Upstream OAI Helm charts — fetched by scripts/fetch-charts.sh, not vendored
# (separate project, own license and release cadence).
/orchestration/

# Upstream stack fetched by scripts/21-fetch-stack.sh (Aerial, OAI, sample apps)
/stack/

# Chart copies generated by the scale-out script
/orchestration/oai-5g-ran/oai-gnb-cell2/

# Helm dependency artifacts. Scope this to the vendored subdirectory Helm
# creates INSIDE a chart -- a bare "charts/" also matches our own top-level
# charts/ directory and silently stops the DU chart being committed at all.
charts/*/charts/
*.tgz
.helmignore.bak

# Inventory captures — may contain host details, MACs, IPs, serials.
# THIS REPO IS PUBLIC: never commit these.
aerial-inventory-*/
ran-recipe-*/
*-inventory-*.tar.gz
*.pcap

# Site-specific values (fronthaul MAC/VLAN, PCIe ids, cell identity, creds).
# The tracked tree stays generic; per-deployment values live here.
# Enforced by the pre-commit hook from scripts/install-guardrails.sh
/site/*
!/site/README.md

# kubeconfig / credentials — never commit
kubeconfig*
*.kubeconfig
.env
